{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutor",
  "compatibility_date": "2025-03-01",
  // Static-assets-only Worker (no server script) → free Workers plan.
  // `next build` with output:"export" emits ./out.
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
