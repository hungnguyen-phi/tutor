{
  "name": "@tutor/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "apply": "node --env-file=../../.env --import tsx src/apply-sql.ts",
    "seed": "node --env-file=../../.env --import tsx src/seed.ts",
    "import:kg": "node --env-file=../../.env --import tsx src/import-kg.ts",
    "convert:kg": "node --import tsx src/convert-studio-kg.ts",
    "convert:questions": "node --import tsx src/convert-studio-questions.ts",
    "export:path": "node --import tsx src/export-static-path.ts",
    "seed:rbac": "node --env-file=../../.env --import tsx src/seed-rbac.ts",
    "seed:auth": "node --env-file=../../.env --import tsx src/seed-auth.ts",
    "seed:coaching": "node --env-file=../../.env --import tsx src/seed-coaching.ts",
    "seed:demo": "node --env-file=../../.env --import tsx src/seed-demo-users.ts",
    "studio": "drizzle-kit studio",
    "lint": "echo \"(db) no lint yet\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tutor/shared": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
