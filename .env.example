# Copy to .env (gitignored). NEVER commit real values.
# The frontend is a PUBLIC static site — put NO secrets in apps/web or NEXT_PUBLIC_*.
# Secrets live only in: (1) this local .env, (2) Supabase Edge Function secrets.

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://uksbvlkhcyhnpfamducc.supabase.co
# Publishable (anon) key is safe in the browser:
SUPABASE_ANON_KEY=sb_publishable_ZLDlbkDCmpLDgsOQnfsG3w_lbavhh7S
# Server-only — Supabase dashboard → Settings → API. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# DB connection. The direct host (db.<ref>.supabase.co) is IPv6-only on many
# networks → use the IPv4 Session pooler. Prefer the discrete vars below (raw
# password, no URL-encoding pitfalls). Get host/region from Supabase → Settings
# → Database → Connection string → "Session pooler".
DATABASE_URL=postgresql://postgres.<ref>:[PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=aws-1-<region>.pooler.supabase.com
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PORT=5432

# ── LLM Gateway (FREE pilot = OpenRouter) ─────────────────
# Get a free key at https://openrouter.ai/keys . Used server-side (Edge Functions) only.
OPENROUTER_API_KEY=
# Optional attribution headers for OpenRouter:
OPENROUTER_REFERER=https://tutor.truongvietanh-5c361252.workers.dev
OPENROUTER_TITLE=AI Tutor - Truong Viet Anh
# Optional paid fallback (kept in the gateway, off by default):
# ANTHROPIC_API_KEY=

# ── Speaking (M3 English) — free options ──────────────────
# Pilot uses the browser Web Speech API (no key). Optional real phoneme scoring
# via Azure Speech F0 free tier (5h/month):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ── n8n ───────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.truongvietanh.com
# N8N_WEBHOOK_ENDSESSION=
