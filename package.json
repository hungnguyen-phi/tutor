{
  "name": "tutor",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptive AI Tutor — Trường Việt Anh (multi-subject, multi-tenant)",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tutor/db generate",
    "db:migrate": "pnpm --filter @tutor/db migrate",
    "db:push": "pnpm --filter @tutor/db push",
    "web:dev": "pnpm --filter @tutor/web dev",
    "web:deploy": "pnpm --filter @tutor/web deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
